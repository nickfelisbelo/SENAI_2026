generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Turmas {
  id Int @id @default(autoincrement())
  nome String
  capacidade Int
  alunos Alunos[]
}

model Alunos {
  id Int @id @default(autoincrement())
  nome String
  matricula Int
  turmasId Int
  turmas Turmas @relation(fields: [turmasId], references: [id])
}